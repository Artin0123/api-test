{
  "name": "api-test",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler pages dev public --kv=KV_STORE --binding STORAGE_BACKEND=kv",
    "dev:d1": "wrangler pages dev public --kv=KV_STORE --d1=DB=local-dev-db",
    "build": "node scripts/build-worker.mjs",
    "check": "node scripts/build-worker.mjs && node scripts/check-syntax.mjs",
    "test": "node --test tests/",
    "migrate": "node scripts/migrate-kv-to-d1.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.160.0"
  }
}
